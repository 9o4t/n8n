# Local compose only. On Railway these are wired or generated — do not paste
# provider API keys into the template. n8n needs none to boot.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# Required for local compose. Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Public URL n8n prints on webhook nodes. Local default is fine.
WEBHOOK_URL=http://localhost:5678/

# Optional
GENERIC_TIMEZONE=UTC
N8N_SECURE_COOKIE=false
